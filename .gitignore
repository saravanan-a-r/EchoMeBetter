# ---------------------------------------------------------------------------
# Markdown. Only the root README is committed -- everything else (design
# docs, module READMEs, research notes) stays local, untracked.
# ---------------------------------------------------------------------------
*.md
*.MD
!/README.md

# ---------------------------------------------------------------------------
# Corpora and generated data. These are rebuildable from the downloaders in
# tokenizer/tokenizer_training_corpus_downloader/ and are far too large to
# version. The *.manifest sidecars ARE tracked, so provenance travels with
# the code.
# ---------------------------------------------------------------------------
tokenizer/tokenizer_training_corpus_downloader/output/*
!tokenizer/tokenizer_training_corpus_downloader/output/*.manifest.json

# The sampled fitting corpus and the replayed eval slice. Both are derived
# artifacts, reproducible from the manifest + seed.
tokenizer/training/output/corpus.txt
tokenizer/training/output/tokenizer_evals_set.jsonl

# pretrain_corpus/'s own output: downloaded/cleaned shards, staged Stack
# Exchange archives and extracted XML, the run manifest, and the PII audit
# log, all rebuildable from download.py + the same seed. pii_registry.json
# is deliberately excluded from this rule and stays untracked too, but for
# a different reason: it is mutable run state (a high-water mark), not a
# static input -- unlike pii_pools.json/legacy_reserved.json alongside it,
# which ARE real source data and stay tracked.
pretrain_corpus/output/*
pretrain_corpus/data/pii_registry.json
pretrain_corpus/data/pii_registry.json.lock
pretrain_corpus/data/pii_audit.jsonl
# Run logs written by `pretrain.py --log-file`. Run state, not source.
pretrain_corpus/logs/

# ---------------------------------------------------------------------------
# Training runs and checkpoints
# ---------------------------------------------------------------------------
runs/
*/runs/
*.safetensors
*.pt
*.bin
*.ckpt
checkpoint-*/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
